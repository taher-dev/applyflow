# Server Port
PORT=5000

# Application Environment (development, production, test)
NODE_ENV=development

# Allowed CORS Origin (Frontend URL in dev)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Connection String for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/applyflow_dev?schema=public"

# Optional: Isolated Test Database URL (defaults to applyflow_test in test environment)
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/applyflow_test?schema=public"

# Development-only Mock Authentication (disabled outside development)
ENABLE_DEMO_AUTH=true

# Optional: Google OAuth 2.0 Client ID for token audience verification
# GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# Password Reset Email Delivery
# Option 1: Resend HTTP API (Recommended for Vercel/Serverless)
# RESEND_API_KEY="re_xxxxxxxxxxxxxx"
# EMAIL_FROM="ApplyFlow <onboarding@resend.dev>"

# Option 2: Standard SMTP
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_SECURE=false

# App Public URL for email confirmation links
# APP_URL="https://applyflow-iota-sage.vercel.app"

